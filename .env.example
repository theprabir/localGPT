# LocalGPT environment configuration
# Copy this file to .env and adjust values for your machine.
# See docs/configuration.md for details.

# Application
LOCALGPT_HOST=127.0.0.1
LOCALGPT_PORT=8000

# llama.cpp server (llama-server)
# LocalGPT communicates with llama-server over HTTP using an OpenAI-compatible API.
# Start llama-server with a supported SmolVLM2 / Qwen3-VL GGUF before running LocalGPT.
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Multimodal model selection
# Supported: smolvlm2-2.2b (primary), qwen3-vl-2b (alternative)
VLM_MODEL=smolvlm2-2.2b

# Model filesystem path (GGUF bundle or directory llama-server can load)
# Leave unset only if you configure llama-server to load models from its own paths.
VLM_MODEL_PATH=

# Context / token budget when running llama-server for LocalGPT
# Keep this conservative for 10 GB RAM target hardware.
VLM_MAX_CONTEXT_TOKENS=2048

# Image generation defaults (Phase 2)
IMAGE_MODEL=sd-turbo
MAX_IMAGE_SIZE=512
IMAGE_STEPS=2

# Logging
LOG_LEVEL=INFO
